filters:
  and:
    - type == "project"
    - status != "archived"
    - file.inFolder("Projects")
views:
  - type: table
    name: All
    order:
      - file.name
      - client
      - status
      - start_date
  - type: cards
    name: Active
    filters: status == "active"
    order:
      - file.name
      - client
      - start_date
