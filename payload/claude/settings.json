{
  "outputStyle": "Operational Specification",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run list:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.production)",
      "Read(**/*.pem)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/no-general-purpose-agent.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/vault-write-gate.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/git-push-guard.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/destructive-git-gate.sh"
          }
        ]
      },
      {
        "matcher": "mcp__.*__(send_.*|reply.*|create_post|dm|create_message|post_message)",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/outbound-ask.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "operator",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/operator-done-gate.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/session-start-doctor.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
