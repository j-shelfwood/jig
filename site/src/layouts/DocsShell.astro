---
// DocsShell: the docs frame over BaseLayout. Sidebar in reading order (docs-nav.ts), the article, a
// table of contents rail from the page's h2/h3 headings, and prev/next cards. The prose rules below are
// the talos-ui showcase's docs prose, plus callouts (talos-alert markup from remark-callouts) and mermaid.
import BaseLayout from "./BaseLayout.astro";
import LinkCard from "@j_shelfwood/talos-ui/astro/LinkCard.astro";
import "@j_shelfwood/talos-ui/talos-motion.css";
import { docsNav, docsHref } from "../docs-nav";

interface Props {
  title: string;
  description?: string;
  /** Collection id of the current page ("index", "method", ...), for active state and prev/next. */
  slug: string;
  headings: { depth: number; slug: string; text: string }[];
}
const { title, description, slug, headings } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const at = docsNav.findIndex((item) => item.slug === slug);
const prev = at > 0 ? docsNav[at - 1] : undefined;
const next = at >= 0 && at < docsNav.length - 1 ? docsNav[at + 1] : undefined;
---

<BaseLayout title={title} description={description} navActive={slug === "method" ? "method" : "docs"} frame="bare" toc={toc}>
  <div class="docs-frame">
    <aside class="talos-sidebar docs-sidebar" aria-label="Docs">
      <div class="talos-nav-group">
        <span class="talos-nav-group__label">Docs</span>
        {
          docsNav.map((item) => (
            <a
              class:list={["talos-nav-item", item.slug === slug && "talos-nav-item--active"]}
              href={docsHref(item.slug)}
              aria-current={item.slug === slug ? "page" : undefined}
            >
              <span class="talos-nav-item__label">{item.label}</span>
            </a>
          ))
        }
      </div>
    </aside>

    <main class="docs-main">
      <div class="docs-head talos-stack">
        <span class="talos-eyebrow">// {docsNav[at]?.label ?? title}</span>
        <h1 class="docs-title">{title}</h1>
        {description && <p class="talos-muted docs-lede">{description}</p>}
      </div>
      <article class="docs-prose">
        <slot />
      </article>

      <nav class="docs-pager" aria-label="Previous and next page">
        {prev ? <LinkCard href={docsHref(prev.slug)} title={prev.label} eyebrow="Previous" class="docs-pager__prev talos-pad" /> : <span />}
        {next && <LinkCard href={docsHref(next.slug)} title={next.label} eyebrow="Next" class="docs-pager__next talos-pad" />}
      </nav>
    </main>

    {
      toc.length > 0 && (
        <nav class="docs-toc" aria-label="On this page">
          <span class="talos-nav-group__label">On this page</span>
          <ul>
            {toc.map((h) => (
              <li data-depth={h.depth}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>

  <script>
    import { renderMermaid } from "../scripts/mermaid";
    renderMermaid();
  </script>

  <style is:global>
    /* --- Three-column frame: sidebar, article, table of contents ------------ */
    .docs-frame {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: 14rem minmax(0, 1fr) 14rem;
      max-width: 1320px;
      margin: 0 auto;
      padding-top: calc(var(--site-nav-h) + 1rem);
      align-items: start;
    }
    .docs-sidebar,
    .docs-toc {
      position: sticky;
      top: calc(var(--site-nav-h) + 1rem);
      align-self: start;
      max-height: calc(100vh - var(--site-nav-h) - 2rem);
      overflow-y: auto;
    }
    .docs-sidebar { width: auto; background: transparent; }
    .docs-main { min-width: 0; padding: 3.5rem 2.5rem 4rem; }
    .docs-head { margin-bottom: 2.5rem; }
    .docs-title {
      font-weight: 300;
      text-transform: uppercase;
      letter-spacing: var(--talos-tracking-hud);
      margin: 0;
      font-size: clamp(1.6rem, 3.5vw, 2.6rem);
      line-height: 1.1;
      overflow-wrap: anywhere;
    }
    .docs-lede { max-width: 60ch; font-size: 1.02rem; margin: 0; }

    .docs-toc { padding: 1.5rem 0.75rem; border-left: 1px solid var(--talos-edge-subtle); }
    .docs-toc ul { list-style: none; margin: 0.5rem 0 0; padding: 0; }
    .docs-toc li { margin: 0; }
    .docs-toc li[data-depth="3"] { padding-left: 0.85rem; }
    .docs-toc a {
      display: block;
      padding: 0.3rem 0.75rem;
      font-size: 0.78rem;
      line-height: 1.4;
      color: var(--talos-text-secondary);
      text-decoration: none;
    }
    .docs-toc a:hover { color: var(--talos-text-primary); }

    .docs-pager {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      max-width: 70ch;
      margin-top: 4rem;
    }
    .docs-pager__next { grid-column: 2; text-align: right; }

    @media (max-width: 1180px) {
      .docs-frame { grid-template-columns: 14rem minmax(0, 1fr); max-width: 1180px; }
      .docs-toc { display: none; }
    }
    @media (max-width: 820px) {
      .docs-frame { grid-template-columns: 1fr; }
      .docs-sidebar { position: static; max-height: none; border-right: 0; border-bottom: 1px solid var(--talos-edge-subtle); padding: 0.75rem 1rem; }
      .docs-sidebar .talos-nav-group { flex-direction: row; flex-wrap: wrap; }
      .docs-sidebar .talos-nav-group__label { width: 100%; }
      .docs-main { padding: 2rem 1.25rem 3rem; }
      .docs-pager { grid-template-columns: 1fr; }
      .docs-pager__next { grid-column: 1; }
    }

    /* --- Markdown prose, talos-styled (from the talos-ui showcase DocsShell) - */
    .docs-prose { max-width: 70ch; }
    .docs-prose > * + * { margin-top: 1.15rem; }
    .docs-prose p,
    .docs-prose li {
      font-family: var(--talos-font-body, var(--talos-font-display));
      font-size: 0.98rem;
      line-height: 1.7;
      color: hsl(var(--talos-foreground-hsl) / 0.86);
    }
    .docs-prose h2,
    .docs-prose h3 {
      font-weight: 300;
      text-transform: uppercase;
      letter-spacing: var(--talos-tracking-hud-tight);
      color: var(--talos-text-primary);
      margin-top: 2.75rem;
    }
    .docs-prose h2 { font-size: 1.15rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--talos-edge-subtle); }
    .docs-prose h3 { font-size: 1rem; }
    .docs-prose a {
      color: var(--talos-accent);
      text-decoration: none;
      border-bottom: 1px solid hsl(var(--talos-accent-hsl) / 0.35);
    }
    .docs-prose a:hover { border-bottom-color: var(--talos-accent); }
    .docs-prose strong { color: var(--talos-text-primary); font-weight: 500; }

    .docs-prose :not(pre) > code {
      font-family: var(--talos-font-mono, ui-monospace, monospace);
      font-size: 0.85em;
      padding: 0.12em 0.4em;
      background: var(--talos-surface-2);
      border: 1px solid var(--talos-edge-subtle);
      border-radius: var(--talos-radius-sm);
      color: var(--talos-text-primary);
      overflow-wrap: anywhere;
    }

    /* Syntax palette for the talos shiki theme (talos-code-theme.mjs). */
    .docs-prose {
      --talos-code-bg: var(--talos-surface-1);
      --talos-code-fg: hsl(var(--talos-foreground-hsl) / 0.86);
      --talos-code-comment: hsl(var(--talos-foreground-hsl) / 0.38);
      --talos-code-punctuation: hsl(var(--talos-foreground-hsl) / 0.45);
      --talos-code-keyword: hsl(var(--talos-info-hsl) / 0.95);
      --talos-code-tag: var(--talos-accent);
      --talos-code-attribute: hsl(var(--talos-accent-hsl) / 0.6);
      --talos-code-string: hsl(var(--talos-warning-hsl) / 0.9);
      --talos-code-constant: hsl(var(--talos-danger-hsl) / 0.85);
      --talos-code-function: var(--talos-text-primary);
      --talos-code-type: hsl(var(--talos-info-hsl) / 0.75);
      --talos-code-property: hsl(var(--talos-foreground-hsl) / 0.72);
      --talos-code-deleted: var(--talos-danger);
    }

    /* Fenced code blocks: chamfered frame on the talos chamfer engine (astro.config.mjs adds the classes). */
    .docs-prose pre {
      --_fill: var(--talos-surface-1);
      font-family: var(--talos-font-mono, ui-monospace, monospace);
      font-size: 0.85rem;
      line-height: 1.6;
      padding: 1.1rem 1.25rem;
      overflow-x: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--talos-edge-default) transparent;
    }
    .docs-prose pre > code {
      position: relative;
      z-index: 0;
      background: none;
      border: 0;
      padding: 0;
      font-size: inherit;
      color: inherit;
    }

    /* Tables: zebra hairline, HUD header; wide tables scroll inside their own box. */
    .docs-prose table {
      display: block;
      max-width: 100%;
      overflow-x: auto;
      border-collapse: collapse;
      font-size: 0.9rem;
    }
    .docs-prose th {
      text-align: left;
      font-family: var(--talos-font-display);
      font-weight: 400;
      text-transform: uppercase;
      letter-spacing: var(--talos-tracking-hud-tight);
      font-size: 0.72rem;
      color: var(--talos-text-tertiary);
      padding: 0.6rem 0.9rem;
      border-bottom: 1px solid var(--talos-edge-strong);
    }
    .docs-prose td {
      padding: 0.6rem 0.9rem;
      border-bottom: 1px solid var(--talos-edge-subtle);
      color: hsl(var(--talos-foreground-hsl) / 0.86);
      font-family: var(--talos-font-body);
      vertical-align: top;
      line-height: 1.55;
    }
    .docs-prose tbody tr:nth-child(even) { background: hsl(var(--talos-foreground-hsl) / 0.02); }

    .docs-prose ul,
    .docs-prose ol { padding-left: 1.25rem; }
    .docs-prose li { margin-top: 0.35rem; }
    .docs-prose li::marker { color: var(--talos-accent); }

    .docs-prose blockquote {
      margin-inline: 0;
      padding: 0.25rem 1rem;
      border-left: 2px solid var(--talos-edge-default);
    }

    /* Callouts: talos-alert blocks (remark-callouts). The body holds block markdown, so its own
       paragraphs and lists keep the prose rhythm at the alert's smaller size. */
    .docs-prose .callout { margin-block: 1.75rem; }
    .docs-prose .callout .talos-alert__body > * { margin: 0; }
    .docs-prose .callout .talos-alert__body > * + * { margin-top: 0.6rem; }
    .docs-prose .callout :is(p, li) { font-size: 0.92rem; line-height: 1.6; color: var(--talos-text-secondary); }
    .docs-prose .callout :is(ul, ol) { padding-left: 1.1rem; }

    /* Mermaid: the diagram replaces its <pre> once rendered (src/scripts/mermaid.ts). */
    .docs-prose .mermaid-diagram {
      --_fill: var(--talos-surface-1);
      padding: 1.25rem;
      overflow-x: auto;
      text-align: center;
    }
    .docs-prose .mermaid-diagram svg { max-width: 100%; height: auto; }
  </style>
</BaseLayout>
