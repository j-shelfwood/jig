---
import { getCollection, render } from "astro:content";
import DocsShell from "../../layouts/DocsShell.astro";
import { docsNav } from "../../docs-nav";

// One page per docs/*.md. "index" renders at /docs/, every other entry at /docs/<id>/. Two cases fail the
// build: a page missing from the sidebar (unreachable from the nav), and a page whose markdown did not
// render. The glob loader only logs a render error (for example a dead wikilink thrown by
// remark-wikilinks) and keeps the entry without `rendered`, which would ship an empty page.
export async function getStaticPaths() {
  const entries = await getCollection("docs");
  for (const entry of entries) {
    if (!docsNav.some((item) => item.slug === entry.id)) {
      throw new Error(`docs/${entry.id}.md is not listed in site/src/docs-nav.ts`);
    }
    if (!entry.rendered?.html) {
      throw new Error(`docs/${entry.id}.md did not render; the markdown error is logged above`);
    }
  }
  return entries.map((entry) => ({
    params: { slug: entry.id === "index" ? undefined : entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsShell title={entry.data.title} description={entry.data.description} slug={entry.id} headings={headings}>
  <Content />
</DocsShell>
